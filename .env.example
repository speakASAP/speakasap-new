# SpeakASAP Platform Environment Variables
# Port Range: 42xx (4200-4219)
# Copy this file to speakasap/.env (repo root only). Do not maintain per-service .env copies.

# ============================================
# Port Configuration (42xx Range)
# ============================================
# Certification/assessment keys below: when unset, docker-compose.blue.yml / docker-compose.green.yml substitute defaults (4202/4203, service names, DB names, DATABASE_URL host db-server-postgres — password still required in real .env).
# Service Ports
CONTENT_SERVICE_PORT=
CONTENT_SERVICE_PORT_GREEN=
CERTIFICATION_SERVICE_PORT=
ASSESSMENT_SERVICE_PORT=
USER_SERVICE_PORT=
# Host port for green user-service (container still listens on USER_SERVICE_PORT); must differ from blue host bind
USER_SERVICE_PORT_GREEN=
CERTIFICATION_SERVICE_NAME=
ASSESSMENT_SERVICE_NAME=
USER_SERVICE_NAME=
USER_DB_NAME=
CERTIFICATION_DATABASE_URL=
ASSESSMENT_DATABASE_URL=
USER_DATABASE_URL=
COURSE_SERVICE_PORT=
COURSE_SERVICE_PORT_GREEN=
COURSE_SERVICE_NAME=
COURSE_DB_NAME=
COURSE_DATABASE_URL=
COURSE_SOURCE_DATABASE_URL=
COURSE_TARGET_DATABASE_URL=
EDUCATION_SERVICE_PORT=
EDUCATION_SERVICE_PORT_GREEN=
PAYMENT_SERVICE_PORT=
PAYMENT_DB_NAME=
PAYMENT_DATABASE_URL=
# Read-only legacy speakasap-portal Postgres for payment-service ETL (npm run migrate:payment-data in payment-service/)
PAYMENT_LEGACY_DATABASE_URL=
NOTIFICATION_SERVICE_PORT=
# Full Postgres URL for notification-service (path/database must be speakasap_notification_db in prod)
NOTIFICATION_DATABASE_URL=
# Read-only legacy speakasap-portal Postgres for notification-service ETL (npm run migrate:notification-data)
NOTIFICATION_LEGACY_DATABASE_URL=
# Optional: repo path to speakasap-portal for loading template HTML files into bodyHtml (default: sibling directory)
NOTIFICATION_PORTAL_ROOT=
API_GATEWAY_PORT=
# api-gateway upstream base URLs (e.g. http://content-service:4201) — see docs/refactoring/GATEWAY_API_CONTRACT.md
# Optional: trusted callers only — Auth Bearer with internal:speakasap-api-gateway:* for /api/v1/internal/**
FRONTEND_PORT=
SALARY_SERVICE_PORT=
SALARY_DATABASE_URL=
# Read-only legacy speakasap-portal Postgres for salary-service ETL (npm run migrate:salary-data in salary-service/)
SALARY_LEGACY_DATABASE_URL=
# speakasap-salary-service cross-service HTTP (see docs/refactoring/SALARY_API_CONTRACT.md)
PAYMENT_SERVICE_URL=
FINANCIAL_SERVICE_PORT=
FINANCIAL_SERVICE_PORT_GREEN=
FINANCIAL_DB_NAME=
FINANCIAL_DATABASE_URL=
# speakasap-financial-service cross-service HTTP (see docs/refactoring/FINANCIAL_API_CONTRACT.md)
SALARY_SERVICE_URL=
COURSE_SERVICE_URL=
# Outbound X-Internal-Token to payment/salary/course (receivers not yet Auth RS256)
PAYMENT_SERVICE_INTERNAL_TOKEN=
SALARY_SERVICE_INTERNAL_TOKEN=
COURSE_SERVICE_INTERNAL_TOKEN=
FINANCIAL_HTTP_TIMEOUT_MS=
FINANCIAL_DISPLAY_CURRENCY=

# Reserved for future speakasap services: 4200, 4204, 4216-4219 (4214-4215: standalone marathon/)

# ============================================
# Database Configuration (Shared database-server)
# ============================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Database Names (one per service)
DB_NAME=
DATABASE_URL=
# Also configure for:
# - speakasap_certification_db
# - speakasap_assessment_db
# - speakasap_course_db
# - speakasap_education_db
# - speakasap_user_db
# - speakasap_payment_db
# - speakasap_notification_db
# - speakasap_salary_db
# - speakasap_financial_db

# ============================================
# Shared Microservices Configuration
# ============================================
# Auth Microservice
AUTH_SERVICE_URL=
# Per-pair Auth-issued RS256 JWT for speakasap→auth internal calls (preferred).
AUTH_SERVICE_TOKEN=
# Legacy static shared secret — migration fallback until auth closes static path.
INTERNAL_SERVICE_TOKEN=
AUTH_MICROSERVICE_PORT=
AUTH_TEST_EMAIL=
AUTH_TEST_PASSWORD=

# Logging Microservice
LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_PATH=
LOGGING_MICROSERVICE_PORT=

# Notifications Microservice
NOTIFICATION_SERVICE_URL=
NOTIFICATIONS_MICROSERVICE_PORT=
# Optional API key header when notifications-ms requires it
# speakasap user-service base URL for internal email / do-not-contact resolution (e.g. http://user-service:4210)
USER_SERVICE_URL=

# Payments Microservice
PAYMENTS_MICROSERVICE_URL=
PAYMENTS_MICROSERVICE_PORT=
PAYMENTS_MICROSERVICE_API_KEY=
PAYMENT_APPLICATION_ID=
PAYMENTS_CHECKOUT_CALLBACK_URL=
PAYMENTS_WEBHOOK_SHARED_SECRET=

# AI Microservice
# Shared by content-service (translation) and education-service (drilling generation/validation)
AI_SERVICE_URL=http://ai-microservice:3380
AI_MICROSERVICE_PORT=
AI_SERVICE_TIMEOUT=
AI_SERVICE_API_KEY=
AI_SERVICE_TRANSLATE_PATH=

# ============================================
# Application Configuration
# ============================================
SERVICE_NAME=
PORT=
NODE_ENV=
DOMAIN=
HTTP_TIMEOUT=
GATEWAY_TIMEOUT=
AUTH_SERVICE_TIMEOUT=
NOTIFICATION_SERVICE_TIMEOUT=
LOGGING_SERVICE_TIMEOUT=
RETRY_MAX_ATTEMPTS=
RETRY_DELAY_MS=
AUTH_RETRY_MAX_ATTEMPTS=
AUTH_RETRY_DELAY_MS=
NOTIFICATION_RETRY_MAX_ATTEMPTS=
NOTIFICATION_RETRY_DELAY_MS=
CORS_ORIGIN=
FRONTEND_URL=

# ============================================
# Prisma / Redis (optional; marathon-style services)
# ============================================
PRISMA_SCHEMA_ENGINE_BINARY=
PRISMA_QUERY_ENGINE_BINARY=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ============================================
# Logging (app-level)
# ============================================
LOG_LEVEL=
LOG_TIMESTAMP_FORMAT=

# ============================================
# Content-oriented defaults (when using content-style services)
# ============================================
DEFAULT_PAGE_SIZE=
MAX_PAGE_SIZE=
ASSETS_BASE_URL=

# Frontend Configuration
NEXT_PUBLIC_API_URL=

# ============================================
# Monorepo SSOT (single file: copy to ./.env at repo root only)
# ============================================
# Per-service `*/.env` copies under speakasap/ are not used; templates live only here.
# Docker Compose uses `env_file: ../.env` from service dirs or root compose.
# Prisma CLI: use `npm run prisma:validate` (loads ../.env and the right DATABASE_URL alias).

# --- Content service (Phase 1) extras ---

# --- Certification service (Phase 2) ---
JWT_SECRET=
CERT_VIEW_TOKEN_SECRET=
MATERIALS_PUBLIC_BASE_URL=
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
CERTIFICATION_SOURCE_DATABASE_URL=
CERTIFICATION_TARGET_DATABASE_URL=
ASSESSMENT_SOURCE_DATABASE_URL=
ASSESSMENT_TARGET_DATABASE_URL=

# --- Assessment service (Phase 2) ---
LANGUAGE_TEST_LANDING_BASE_URL=
ASSESSMENT_SERVICE_PUBLIC_BASE_URL=
ASSESSMENT_VIEW_TOKEN_SECRET=
# Docker: set to /app/assets (assessment-service Dockerfile copies ./assets there)
# In Docker, defaults to /app/assets (see docker-compose.*.yml) if unset.
USER_TEST_ASSETS_DIR=

# --- Intra-SpeakASAP Auth RS256 pair JWTs (SERVICE_IDENTITY_CONSUMER_STANDARD) ---
# Gateway /api/v1/internal/* entry: Auth Bearer with internal:speakasap-api-gateway:*.
# No GATEWAY_INTERNAL_API_TOKEN — static entry hop deleted.
# Legacy shared INTERNAL_API_TOKEN (outbound receivers still migrating off it):
INTERNAL_API_TOKEN=
# Gateway second-hop Authorization Bearer stamps:
GATEWAY_TO_USER_SERVICE_TOKEN=
GATEWAY_TO_EDUCATION_SERVICE_TOKEN=
GATEWAY_TO_CONTENT_SERVICE_TOKEN=
GATEWAY_TO_FINANCIAL_SERVICE_TOKEN=
GATEWAY_TO_PAYMENT_SERVICE_TOKEN=
GATEWAY_TO_SALARY_SERVICE_TOKEN=
GATEWAY_TO_COURSE_SERVICE_TOKEN=
# Education outbound
EDUCATION_TO_NOTIFICATION_SERVICE_TOKEN=
EDUCATION_TO_CONTENT_SERVICE_TOKEN=
# Notification → user-service
NOTIFICATION_TO_USER_SERVICE_TOKEN=
# Salary → education
SALARY_TO_EDUCATION_SERVICE_TOKEN=

# --- User ETL (migrate-user-from-legacy.py); optional operator-only ---
# On alfares host: set TARGET_DATABASE_URL and AUTH_DATABASE_URL with the Kubernetes PostgreSQL service DNS. Services keep USER_DATABASE_URL with db-server-postgres.
AUTH_DATABASE_URL=

# --- course-materials-service (sibling folder; compose --env-file ../.env) ---

CERTIFICATION_SERVICE_DOMAIN=
ASSESSMENT_SERVICE_DOMAIN=

EDUCATION_DB_NAME=
EDUCATION_SERVICE_NAME=
EDUCATION_DATABASE_URL=
EDUCATION_SOURCE_DATABASE_URL=
EDUCATION_TARGET_DATABASE_URL=

# Unified payments configuration
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_API_KEY=
PAYMENT_CALLBACK_URL=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=

JWT_TOKEN=

# --- Drilling assignments ---
# AI_SERVICE_URL is declared above (AI Microservice section) and shared with the
# translation feature — do not re-declare it here.
# Model tier for drill generation and validation. 'smart' = best available.
DRILL_GENERATION_MODEL_TIER=smart
# Seconds before a GENERATING set is swept to CANCELLED
DRILL_GENERATION_TIMEOUT_SECONDS=600
# Shared secret for legacy portal -> platform SSO (Vault: secret/prod/speakasap-portal)
SPEAKASAP_PLATFORM_JWT_SECRET=
# Public base URL used in emails and legacy portal links
SPEAKASAP_PLATFORM_URL=https://speakasap.alfares.cz
